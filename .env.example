# .env로 복사하세요. 실제 .env는 Git에 올리지 마세요.
APP_DEBUG=1
# 코치 PC의 루프백 접속만 로그인 없이 관리자 권한
APP_LOCAL_COACH=1
# 기본 공통 주소 모드: 모든 활성 선수 기록 공유/업로드/비교/엑셀
# 선수별 비공개 링크 방식이 필요하면 0으로 바꾸세요.
APP_OPEN_PORTAL=1
APP_SECURE=0
APP_TRUST_PROXY=0
APP_ALLOWED_HOSTS=localhost,127.0.0.1
APP_CSRF_TRUSTED_ORIGINS=
# 실제 외부 HTTPS 주소. 로컬 PC에서만 쓰면 비워 두어도 됩니다.
APP_PUBLIC_URL=
# 외부 서버는 APP_LOCAL_COACH=0, APP_DEBUG=0 필수입니다.
# 운영 키 생성: python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_SECRET_KEY=
# 공란이면 기본 data 폴더. Windows 예: D:/kwon-lesson-data
APP_DATA_DIR=
